{
  "name": "iobroker.sayit",
  "version": "5.3.1",
  "description": "Text to speech interface for ioBroker.",
  "author": {
    "name": "bluefox",
    "email": "dogafox@gmail.com"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "contributors": [
    {
      "name": "bluefox",
      "email": "dogafox@gmail.com"
    },
    {
      "name": "Jey-Cee",
      "email": "jey-cee@live.com"
    },
    {
      "name": "apollon77",
      "email": "iobroker@fischer-ka.de"
    }
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.sayit",
  "keywords": [
    "ioBroker",
    "text to speech",
    "TTS",
    "Voice synthesis"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.sayit"
  },
  "optionalDependencies": {
    "castv2-client": "^1.2.0",
    "mdns": "^2.7.2"
  },
  "dependencies": {
    "jsftp": "^2.1.3",
    "@aws-sdk/client-polly": "^3.1104.0",
    "@iobroker/adapter-core": "^3.4.3",
    "google-tts-api": "^2.0.2",
    "axios": "^1.20.0",
    "mp3-duration": "^1.1.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^3.0.0",
    "@types/jsftp": "^2.1.5",
    "@types/mdns": "^0.0.38",
    "blockly": "^13.2.1",
    "esbuild": "^0.28.1",
    "typescript": "~6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.sayit/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "cmdmp3/",
    "build/",
    "mp3/",
    "nircmd/",
    "say/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test": "mocha --exit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/testPackageFiles.js --exit",
    "test:integration": "mocha test/testAdapter.js --exit",
    "build": "tsc -p tsconfig.build.json && npm run build:blockly",
    "build:blockly": "tsc -p src-blockly/tsconfig.json && node src-blockly/build.mjs",
    "prepublishOnly": "npm run build",
    "install": "node build/main.js --install",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "translate": "translate-adapter -b admin/i18n/en.json -b src-blockly/i18n/en.json",
    "npm": "npm install --ignore-scripts",
    "update-packages": "npx -y npm-check-updates --upgrade"
  },
  "license": "MIT",
  "readmeFilename": "README.md"
}
